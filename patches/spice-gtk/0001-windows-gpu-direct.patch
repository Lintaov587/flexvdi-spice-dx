+#define RELEASE(p) do { if (p) { (p)->Release(); (p) = nullptr; } } while (0)
+#define CHECK(call) do { HRESULT result = (call); if (FAILED(result)) { \
+    g_set_error(error, G_IO_ERROR, G_IO_ERROR_FAILED, "%s: 0x%08lx", \
+                #call, (unsigned long)result); return FALSE; } } while (0)
