+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <glib-object.h>
+#include <gst/gst.h>
+
+/* Shared ABI between the GLib decoder and GTK presenter. No GTK calls are
+ * allowed from present(). The mutex also serializes HWND destruction. */
+typedef struct SpiceDirectBinding {
+    gint refs;
+    GMutex mutex;
+    gpointer owner;
+    gboolean submitted;
+    gboolean (*present)(gpointer owner, GstSample *sample, GError **error);
+} SpiceDirectBinding;
+
+typedef struct SpiceDirectHub {
+    gint refs;
+    GMutex mutex;
+    GPtrArray *bindings;
+} SpiceDirectHub;
+
+static inline gboolean spice_direct_enabled(void)
+{
+    return g_strcmp0(g_getenv("SPICE_DX_H264"), "1") == 0 &&
+           g_strcmp0(g_getenv("SPICE_DX_DIRECT"), "0") != 0 &&
+           g_strcmp0(g_getenv("SPICE_DX_LOW_LATENCY"), "0") != 0;
+}
+
+static inline gpointer spice_direct_ref(gpointer p, gpointer unused G_GNUC_UNUSED)
+{
+    if (p) g_atomic_int_inc(&((SpiceDirectBinding *)p)->refs);
+    return p;
+}
+
+static inline void spice_direct_unref(gpointer p)
+{
+    SpiceDirectBinding *b = (SpiceDirectBinding *)p;
+    if (b && g_atomic_int_dec_and_test(&b->refs)) {
+        g_mutex_clear(&b->mutex);
+        g_free(b);
+    }
+}
+
+static inline gpointer spice_direct_hub_ref(gpointer p, gpointer unused G_GNUC_UNUSED)
+{
+    if (p) g_atomic_int_inc(&((SpiceDirectHub *)p)->refs);
+    return p;
+}
+
+static inline void spice_direct_hub_unref(gpointer p)
+{
+    SpiceDirectHub *hub = (SpiceDirectHub *)p;
+    if (hub && g_atomic_int_dec_and_test(&hub->refs)) {
+        g_ptr_array_unref(hub->bindings);
+        g_mutex_clear(&hub->mutex);
+        g_free(hub);
+    }
+}
