+/* Windows desktop presenter. SPDX-License-Identifier: LGPL-2.1-or-later */
+#define COBJMACROS
+#include "config.h"
+#include <initguid.h>
+#include <d3d11.h>
+#include <dxgi1_3.h>
+#include <d3dcompiler.h>
+#include <gdk/gdkwin32.h>
+#include "spice-widget-priv.h"
+#include "spice-gtk-session-priv.h"
+#include "spice-latency-priv.h"
+
+#define RELEASE(p) do { if (p) { IUnknown_Release((IUnknown *)(p)); (p) = NULL; } } while (0)
+#define DX_TRY(expr) do { HRESULT hr_ = (expr); if (FAILED(hr_)) { \
+    g_set_error(error, G_IO_ERROR, G_IO_ERROR_FAILED, "%s failed (0x%08lx)", \
+                #expr, (unsigned long)hr_); goto fail; } } while (0)
+
+typedef struct SpiceD3D11 {
+    HWND window;
+    ID3D11Device *device;
+    ID3D11DeviceContext *context;
+    IDXGISwapChain1 *swap;
+    HANDLE ready;
+    ID3D11RenderTargetView *target;
+    ID3D11VertexShader *vs;
+    ID3D11PixelShader *ps;
+    ID3D11SamplerState *sampler;
+    ID3D11BlendState *blend;
+    ID3D11Texture2D *desktop;
+    ID3D11ShaderResourceView *desktop_view;
+    ID3D11Texture2D *cursor;
+    ID3D11ShaderResourceView *cursor_view;
+    guint scheduled;
+    guint64 frames;
+    gboolean retry;
+    gint width, height, tex_width, tex_height, cursor_width, cursor_height;
+    gchar *base_title;
+    gchar *last_status;
+    gint64 last_traced_frame;
+} SpiceD3D11;
+
+gboolean spice_d3d11_enabled(void)
+{
+    return g_strcmp0(g_getenv("SPICE_DX_H264"), "1") == 0;
+}
+
+/* Hit testing stays in the GTK parent, which already implements SPICE input. */
+static LRESULT CALLBACK output_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    if (msg == WM_NCHITTEST)
+        return HTTRANSPARENT;
+    if (msg == WM_ERASEBKGND)
+        return 1;
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+void spice_d3d11_destroy(SpiceDisplay *display)
+{
+    spice_decode_destroy(display);
+    SpiceD3D11 *dx = display->priv->dx;
+    if (!dx)
+        return;
+    display->priv->dx = NULL;
+    if (dx->scheduled)
+        g_source_remove(dx->scheduled);
+    if (dx->context)
+        ID3D11DeviceContext_ClearState(dx->context);
+    RELEASE(dx->desktop_view); RELEASE(dx->desktop);
+    RELEASE(dx->cursor_view); RELEASE(dx->cursor);
+    RELEASE(dx->target); RELEASE(dx->blend); RELEASE(dx->sampler);
+    RELEASE(dx->vs); RELEASE(dx->ps); RELEASE(dx->swap);
+    if (dx->ready)
+        CloseHandle(dx->ready);
+    RELEASE(dx->context); RELEASE(dx->device);
+    if (dx->window)
+        DestroyWindow(dx->window);
+    g_free(dx->base_title);
+    g_free(dx->last_status);
+    g_free(dx);
+}
+
+static gboolean initialize(SpiceD3D11 *dx, HWND parent, GError **error)
+{
+    static const WCHAR class_name[] = L"SpiceD3D11Output";
+    WNDCLASSW wc = {0};
+    IDXGIDevice *gd = NULL;
+    IDXGIAdapter *adapter = NULL;
+    IDXGIFactory2 *factory = NULL;
+    IDXGISwapChain2 *swap2 = NULL;
+    ID3DBlob *vs = NULL, *ps = NULL, *messages = NULL;
+    DXGI_ADAPTER_DESC adapter_desc;
+    DXGI_SWAP_CHAIN_DESC1 desc = {0};
+    D3D11_SAMPLER_DESC sampler = {0};
+    D3D11_BLEND_DESC blend = {0};
+    gboolean ok = FALSE;
+    const char *shader =
+        "struct V { float4 p:SV_POSITION; float2 uv:TEXCOORD0; };"
+        "V vs_main(uint id:SV_VertexID) { V o;"
+        "float2 u=float2((id<<1)&2,id&2); o.uv=u;"
+        "o.p=float4(u.x*2-1,1-u.y*2,0,1); return o; }"
+        "Texture2D tex:register(t0); SamplerState ss:register(s0);"
+        "float4 ps_main(V i):SV_TARGET { return tex.Sample(ss,i.uv); }";
+
+    wc.lpfnWndProc = output_proc;
+    wc.hInstance = GetModuleHandleW(NULL);
+    wc.lpszClassName = class_name;
+    if (!RegisterClassW(&wc) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED, "Cannot register DX output window");
+        goto fail;
+    }
+    dx->window = CreateWindowExW(WS_EX_TRANSPARENT | WS_EX_NOACTIVATE, class_name, L"",
+                                WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS,
+                                0, 0, 1, 1, parent, NULL, wc.hInstance, NULL);
+    if (!dx->window) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED, "Cannot create DX output window");
+        goto fail;
+    }
+    SetWindowLongPtrW(parent, GWL_STYLE, GetWindowLongPtrW(parent, GWL_STYLE) | WS_CLIPCHILDREN);
+    DX_TRY(D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL,
+                            D3D11_CREATE_DEVICE_BGRA_SUPPORT, NULL, 0, D3D11_SDK_VERSION,
+                            &dx->device, NULL, &dx->context));
+    DX_TRY(ID3D11Device_QueryInterface(dx->device, &IID_IDXGIDevice, (void **)&gd));
+    DX_TRY(IDXGIDevice_GetAdapter(gd, &adapter));
+    DX_TRY(IDXGIAdapter_GetDesc(adapter, &adapter_desc));
+    DX_TRY(IDXGIAdapter_GetParent(adapter, &IID_IDXGIFactory2, (void **)&factory));
+    desc.Width = desc.Height = 1;
+    desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    desc.Scaling = DXGI_SCALING_STRETCH;
+    desc.Flags = DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT;
+    DX_TRY(IDXGIFactory2_CreateSwapChainForHwnd(factory, (IUnknown *)dx->device,
+                                               dx->window, &desc, NULL, NULL, &dx->swap));
+    DX_TRY(IDXGIFactory2_MakeWindowAssociation(factory, dx->window, DXGI_MWA_NO_ALT_ENTER));
+    DX_TRY(IDXGISwapChain1_QueryInterface(dx->swap, &IID_IDXGISwapChain2, (void **)&swap2));
+    DX_TRY(IDXGISwapChain2_SetMaximumFrameLatency(swap2, 1));
+    dx->ready = IDXGISwapChain2_GetFrameLatencyWaitableObject(swap2);
+    if (!dx->ready) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED, "DXGI waitable object unavailable");
+        goto fail;
+    }
+    DX_TRY(D3DCompile(shader, strlen(shader), "spice-dx", NULL, NULL, "vs_main", "vs_4_0",
+                      D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vs, &messages));
+    RELEASE(messages);
+    DX_TRY(D3DCompile(shader, strlen(shader), "spice-dx", NULL, NULL, "ps_main", "ps_4_0",
+                      D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &ps, &messages));
+    DX_TRY(ID3D11Device_CreateVertexShader(dx->device, ID3D10Blob_GetBufferPointer(vs),
+                                          ID3D10Blob_GetBufferSize(vs), NULL, &dx->vs));
+    DX_TRY(ID3D11Device_CreatePixelShader(dx->device, ID3D10Blob_GetBufferPointer(ps),
+                                         ID3D10Blob_GetBufferSize(ps), NULL, &dx->ps));
+    sampler.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sampler.MaxLOD = D3D11_FLOAT32_MAX;
+    DX_TRY(ID3D11Device_CreateSamplerState(dx->device, &sampler, &dx->sampler));
+    blend.RenderTarget[0].BlendEnable = TRUE;
+    blend.RenderTarget[0].SrcBlend = D3D11_BLEND_SRC_ALPHA;
+    blend.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+    blend.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+    blend.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ONE;
+    blend.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_INV_SRC_ALPHA;
+    blend.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+    blend.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+    DX_TRY(ID3D11Device_CreateBlendState(dx->device, &blend, &dx->blend));
+    gchar *description = g_utf16_to_utf8((gunichar2 *)adapter_desc.Description, -1, NULL, NULL, NULL);
+    g_message("DX-H264: renderer=D3D11 adapter=%s vendor=%04x device=%04x "
+              "luid=%08lx:%08lx swap=FLIP_DISCARD buffers=2 max-latency=1",
+              description, adapter_desc.VendorId, adapter_desc.DeviceId,
+              (unsigned long)adapter_desc.AdapterLuid.HighPart,
+              (unsigned long)adapter_desc.AdapterLuid.LowPart);
+    g_free(description);
+    ok = TRUE;
+fail:
+    RELEASE(messages); RELEASE(vs); RELEASE(ps); RELEASE(swap2);
+    RELEASE(factory); RELEASE(adapter); RELEASE(gd);
+    return ok;
+}
+
+static gboolean texture(SpiceD3D11 *dx, gint width, gint height, DXGI_FORMAT format,
+                        ID3D11Texture2D **tex, ID3D11ShaderResourceView **view, GError **error)
+{
+    D3D11_TEXTURE2D_DESC desc = {0};
+    RELEASE(*view); RELEASE(*tex);
+    desc.Width = width; desc.Height = height;
+    desc.MipLevels = desc.ArraySize = desc.SampleDesc.Count = 1;
+    desc.Format = format;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    DX_TRY(ID3D11Device_CreateTexture2D(dx->device, &desc, NULL, tex));
+    DX_TRY(ID3D11Device_CreateShaderResourceView(dx->device, (ID3D11Resource *)*tex, NULL, view));
+    return TRUE;
+fail:
+    return FALSE;
+}
+
+static void draw_texture(SpiceD3D11 *dx, ID3D11ShaderResourceView *view,
+                         float x, float y, float width, float height)
+{
+    D3D11_VIEWPORT vp = { x, y, width, height, 0, 1 };
+    ID3D11DeviceContext_RSSetViewports(dx->context, 1, &vp);
+    ID3D11DeviceContext_PSSetShaderResources(dx->context, 0, 1, &view);
+    ID3D11DeviceContext_Draw(dx->context, 3, 0);
+    view = NULL;
+    ID3D11DeviceContext_PSSetShaderResources(dx->context, 0, 1, &view);
+}
+
+static gboolean render(SpiceDisplay *display, GError **error)
+{
+    SpiceDisplayPrivate *d = display->priv;
+    SpiceD3D11 *dx = d->dx;
+    GtkWidget *area = gtk_stack_get_child_by_name(d->stack, "draw-area");
+    GdkWindow *window = gtk_widget_get_window(area);
+    ID3D11Texture2D *backbuffer = NULL;
+    gint factor, width, height, x, y, image_width, image_height;
+    double scale;
+    DWORD wait;
+    const FLOAT black[4] = {0, 0, 0, 1};
+    dx->retry = FALSE;
+    if (!window || !gtk_widget_get_mapped(area) || !d->canvas.data ||
+        !d->mark || d->area.width <= 0 || d->area.height <= 0)
+        return TRUE;
+    if (!dx->device && !initialize(dx, GDK_WINDOW_HWND(window), error))
+        return FALSE;
+    const gchar *status = d->display ? g_object_get_data(G_OBJECT(d->display), "dx-video-status") : NULL;
+    GtkWidget *top = gtk_widget_get_toplevel(GTK_WIDGET(display));
+    if (GTK_IS_WINDOW(top) && g_strcmp0(dx->last_status, status) != 0) {
+        if (!dx->base_title)
+            dx->base_title = g_strdup(gtk_window_get_title(GTK_WINDOW(top)));
+        gchar *title = g_strdup_printf("%s [DX11 | %s]", dx->base_title ? dx->base_title : "SPICE",
+                                       status ? status : "H.264 requested");
+        gtk_window_set_title(GTK_WINDOW(top), title);
+        g_free(title);
+        g_free(dx->last_status);
+        dx->last_status = g_strdup(status);
+    }
+    if (d->display && g_object_get_data(G_OBJECT(d->display), "dx-video-error")) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                            status ? status : "H.264 negotiation/decoding failed");
+        return FALSE;
+    }
+    factor = gtk_widget_get_scale_factor(area);
+    width = gtk_widget_get_allocated_width(area) * factor;
+    height = gtk_widget_get_allocated_height(area) * factor;
+    if (width < 1 || height < 1)
+        return TRUE;
+    if (dx->width != width || dx->height != height) {
+        ID3D11DeviceContext_OMSetRenderTargets(dx->context, 0, NULL, NULL);
+        RELEASE(dx->target);
+        SetWindowPos(dx->window, NULL, 0, 0, width, height, SWP_NOACTIVATE | SWP_NOZORDER);
+        DX_TRY(IDXGISwapChain1_ResizeBuffers(dx->swap, 2, width, height,
+                                             DXGI_FORMAT_UNKNOWN,
+                                             DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT));
+        DX_TRY(IDXGISwapChain1_GetBuffer(dx->swap, 0, &IID_ID3D11Texture2D, (void **)&backbuffer));
+        DX_TRY(ID3D11Device_CreateRenderTargetView(dx->device, (ID3D11Resource *)backbuffer,
+                                                  NULL, &dx->target));
+        RELEASE(backbuffer);
+        dx->width = width; dx->height = height;
+    }
+    wait = WaitForSingleObject(dx->ready, 0);
+    if (wait == WAIT_TIMEOUT) {
+        dx->retry = TRUE;
+        return TRUE; /* caller schedules one retry; UI thread never blocks */
+    }
+    if (wait != WAIT_OBJECT_0) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED, "DXGI frame wait failed");
+        return FALSE;
+    }
