+        if (!texture(dx, d->area.width, d->area.height, DXGI_FORMAT_B8G8R8A8_UNORM,
+                     &dx->desktop, &dx->desktop_view, error))
+            return FALSE;
+        dx->tex_width = d->area.width; dx->tex_height = d->area.height;
+    }
+    gint stride = d->canvas.convert ? d->area.width * 4 : d->canvas.stride;
+    const guint8 *pixels = d->canvas.data;
