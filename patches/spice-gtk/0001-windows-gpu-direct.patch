+static LRESULT CALLBACK decode_window_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    if (msg == WM_NCHITTEST) return HTTRANSPARENT;
+    if (msg == WM_ERASEBKGND) return 1;
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static gboolean initialize_swap(SpiceDecodePresenter *p, GstD3D11Memory *mem, GError **error)
+{
+    ID3D11Device *device = gst_d3d11_device_get_device_handle(mem->device);
+    IDXGIDevice1 *dxgi = nullptr;
+    IDXGIAdapter *adapter = nullptr;
+    IDXGIFactory2 *factory = nullptr;
+    struct Locals {
+        IDXGIDevice1 *&d; IDXGIAdapter *&a; IDXGIFactory2 *&f;
+        ~Locals() { RELEASE(f); RELEASE(a); RELEASE(d); }
+    } locals {dxgi, adapter, factory};
+    CHECK(device->QueryInterface(__uuidof(IDXGIDevice1), (void **)&dxgi));
+    CHECK(dxgi->GetAdapter(&adapter));
+    CHECK(adapter->GetParent(__uuidof(IDXGIFactory2), (void **)&factory));
+    DXGI_SWAP_CHAIN_DESC1 desc = {};
+    desc.Width = MAX(g_atomic_int_get(&p->width), 1);
+    desc.Height = MAX(g_atomic_int_get(&p->height), 1);
+    desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    desc.Scaling = DXGI_SCALING_STRETCH;
+    /* Each view needs its own single-frame limit. A device-wide limit of one
+     * lets the first view consume every Present slot and starves other views. */
+    desc.Flags = DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT;
+    CHECK(factory->CreateSwapChainForHwnd(device, p->window, &desc, nullptr, nullptr, &p->swap));
+    IDXGISwapChain2 *swap2 = nullptr;
+    CHECK(p->swap->QueryInterface(__uuidof(IDXGISwapChain2), (void **)&swap2));
+    HRESULT latency_result = swap2->SetMaximumFrameLatency(1);
+    swap2->Release();
+    CHECK(latency_result);
+    CHECK(factory->MakeWindowAssociation(p->window, DXGI_MWA_NO_ALT_ENTER));
+    CHECK(device->QueryInterface(__uuidof(ID3D11VideoDevice), (void **)&p->video_device));
+    CHECK(gst_d3d11_device_get_device_context_handle(mem->device)->QueryInterface(
+        __uuidof(ID3D11VideoContext), (void **)&p->video_context));
+    p->device = (GstD3D11Device *)gst_object_ref(mem->device);
+    p->buffer_width = desc.Width; p->buffer_height = desc.Height;
+    D3D11_TEXTURE2D_DESC input;
+    gst_d3d11_memory_get_texture_desc(mem, &input);
+    g_message("DX-DIRECT: same-device NV12 decoder texture=%p bind=0x%x array=%u; "
+              "VideoProcessorBlt directly into BGRA swapchain; CPU copies=0; video timers=0",
+              gst_d3d11_memory_get_resource_handle(mem), input.BindFlags, input.ArraySize);
+    return TRUE;
+}
+
+static gboolean present_sample_impl(SpiceDecodePresenter *p, GstSample *sample, GError **error)
+{
+    /* An occluded secondary window must not pin an old decoder surface. Only
+     * the primary view supplies history thumbnails, and keeps at most one. */
+    g_clear_pointer(&p->latest, gst_sample_unref);
+    if (!IsWindowVisible(p->window) || IsIconic(GetAncestor(p->window, GA_ROOT)))
+        return TRUE;
+    GstBuffer *buffer = gst_sample_get_buffer(sample);
+    if (gst_buffer_n_memory(buffer) != 1 ||
+        !gst_is_d3d11_memory(gst_buffer_peek_memory(buffer, 0))) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Expected native D3D11 memory");
+        return FALSE;
+    }
+    auto *mem = (GstD3D11Memory *)gst_buffer_peek_memory(buffer, 0);
+    GstVideoInfo info;
+    D3D11_TEXTURE2D_DESC input;
+    gst_d3d11_memory_get_texture_desc(mem, &input);
+    if (input.Format != DXGI_FORMAT_NV12 || !(input.BindFlags & D3D11_BIND_DECODER) ||
+        !gst_video_info_from_caps(&info, gst_sample_get_caps(sample))) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "Expected NV12 decoder output texture");
+        return FALSE;
+    }
+    if (p->device && p->device != mem->device) {
+        /* Resizing the remote atlas recreates the decoder and its D3D device.
+         * Rebind this window to that device, keeping the same direct GPU path. */
+        p->release_device();
+        p->failed = false;
+        p->presented = 0;
+        g_message("DX-DIRECT: rebinding swapchain after decoder recreation");
+    }
+    if (p->failed) return TRUE;
+    if (p->crop_w && (p->crop_x + p->crop_w > info.width || p->crop_y + p->crop_h > info.height))
+        return TRUE; // Wait for the resized desktop stream, never show the wrong region.
+    /* Same immediate context orders VP reads before later decoder writes when
+     * this sample returns to its pool. No CPU wait or staging copy is needed. */
+    gst_d3d11_device_lock(mem->device);
+    struct Unlock { GstD3D11Device *d; ~Unlock() { gst_d3d11_device_unlock(d); } } unlock {mem->device};
+    if (!p->swap && !initialize_swap(p, mem, error)) return FALSE;
+    gint width = MAX(g_atomic_int_get(&p->width), 1);
+    gint height = MAX(g_atomic_int_get(&p->height), 1);
+    if (width != p->buffer_width || height != p->buffer_height) {
+        CHECK(p->swap->ResizeBuffers(2, width, height, DXGI_FORMAT_UNKNOWN,
+                                    DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT));
+        p->buffer_width = width; p->buffer_height = height;
+        RELEASE(p->processor); RELEASE(p->enumerator);
+    }
+    if (!p->processor || p->source_width != info.width || p->source_height != info.height) {
+        RELEASE(p->processor); RELEASE(p->enumerator);
+        D3D11_VIDEO_PROCESSOR_CONTENT_DESC content = {};
+        content.InputFrameFormat = D3D11_VIDEO_FRAME_FORMAT_PROGRESSIVE;
+        content.InputWidth = info.width; content.InputHeight = info.height;
+        content.OutputWidth = width; content.OutputHeight = height;
+        content.InputFrameRate = {60, 1}; content.OutputFrameRate = {60, 1};
+        content.Usage = D3D11_VIDEO_USAGE_OPTIMAL_SPEED;
+        CHECK(p->video_device->CreateVideoProcessorEnumerator(&content, &p->enumerator));
+        CHECK(p->video_device->CreateVideoProcessor(p->enumerator, 0, &p->processor));
+        p->video_context->VideoProcessorSetStreamAutoProcessingMode(p->processor, 0, FALSE);
+        p->video_context->VideoProcessorSetStreamFrameFormat(p->processor, 0, D3D11_VIDEO_FRAME_FORMAT_PROGRESSIVE);
+        p->source_width = info.width; p->source_height = info.height;
+    }
+    ID3D11Texture2D *backbuffer = nullptr;
+    ID3D11VideoProcessorInputView *iv = nullptr;
+    ID3D11VideoProcessorOutputView *ov = nullptr;
+    struct Views {
+        ID3D11Texture2D *&b; ID3D11VideoProcessorInputView *&i; ID3D11VideoProcessorOutputView *&o;
+        ~Views() { RELEASE(o); RELEASE(i); RELEASE(b); }
+    } views {backbuffer, iv, ov};
+    CHECK(p->swap->GetBuffer(0, __uuidof(ID3D11Texture2D), (void **)&backbuffer));
+    D3D11_VIDEO_PROCESSOR_INPUT_VIEW_DESC id = {};
+    id.ViewDimension = D3D11_VPIV_DIMENSION_TEXTURE2D;
+    id.Texture2D.ArraySlice = gst_d3d11_memory_get_subresource_index(mem);
+    CHECK(p->video_device->CreateVideoProcessorInputView(gst_d3d11_memory_get_resource_handle(mem),
+        p->enumerator, &id, &iv));
+    D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC od = {};
+    od.ViewDimension = D3D11_VPOV_DIMENSION_TEXTURE2D;
+    CHECK(p->video_device->CreateVideoProcessorOutputView(backbuffer, p->enumerator, &od, &ov));
+    RECT source = {p->crop_x, p->crop_y,
+        p->crop_w ? p->crop_x + p->crop_w : (LONG)info.width,
+        p->crop_h ? p->crop_y + p->crop_h : (LONG)info.height};
+    RECT dest = {0, 0, width, height};
+    p->video_context->VideoProcessorSetStreamSourceRect(p->processor, 0, TRUE, &source);
+    p->video_context->VideoProcessorSetStreamDestRect(p->processor, 0, TRUE, &dest);
+    p->video_context->VideoProcessorSetOutputTargetRect(p->processor, TRUE, &dest);
+    D3D11_VIDEO_PROCESSOR_COLOR_SPACE in_color = {}, out_color = {};
+    in_color.YCbCr_Matrix = info.colorimetry.matrix == GST_VIDEO_COLOR_MATRIX_BT709;
+    in_color.Nominal_Range = info.colorimetry.range == GST_VIDEO_COLOR_RANGE_0_255 ? 2 : 1;
+    out_color.RGB_Range = 0; out_color.Nominal_Range = 2;
+    p->video_context->VideoProcessorSetStreamColorSpace(p->processor, 0, &in_color);
+    p->video_context->VideoProcessorSetOutputColorSpace(p->processor, &out_color);
+    D3D11_VIDEO_PROCESSOR_STREAM stream = {};
+    stream.Enable = TRUE; stream.pInputSurface = iv;
+    CHECK(p->video_context->VideoProcessorBlt(p->processor, ov, 0, 1, &stream));
+    HRESULT hr = p->swap->Present(0, DXGI_PRESENT_DO_NOT_WAIT);
+    if (hr == DXGI_ERROR_WAS_STILL_DRAWING || hr == DXGI_STATUS_OCCLUDED) {
+        ++p->busy; // Discard this decoded presentation; never schedule a timer retry.
+        return TRUE;
+    }
+    CHECK(hr);
+    if (p->crop_x == 0 && p->crop_y == 0)
+        p->latest = gst_sample_ref(sample);
+    if (++p->presented == 1) {
+        g_message("DX-DIRECT: first GPU frame presented; NV12->BGRA on GPU; no CPU canvas; Present(0)");
+        g_object_set_data_full(G_OBJECT(p->channel), "dx-video-status", g_strdup("H.264 decoded"), g_free);
+    }
+    if (p->presented % 600 == 0)
+        g_message("DX-DIRECT: view=%d,%d presented=%" G_GUINT64_FORMAT " busy-skipped=%" G_GUINT64_FORMAT,
+                  p->crop_x, p->crop_y, p->presented, p->busy);
+    return TRUE;
+}
+
+static gboolean present_sample(gpointer owner, GstSample *sample, GError **error)
+{
+    auto *p = (SpiceDecodePresenter *)owner;
+    guint64 before = p->presented;
+    gboolean ok = present_sample_impl(p, sample, error);
+    if (++p->attempts % 300 == 0 && g_strcmp0(g_getenv("SPICE_DX_STATS"), "1") == 0)
+        g_message("DX-VIEW-STATS: view=%d,%d samples=%" G_GUINT64_FORMAT
+                  " presented=%" G_GUINT64_FORMAT " busy=%" G_GUINT64_FORMAT " visible=%d",
+                  p->crop_x, p->crop_y, p->attempts, p->presented, p->busy,
+                  (int)IsWindowVisible(p->window));
+    p->binding->submitted = p->presented != before;
+    if (!ok) p->failed = true;
+    return ok;
+}
+
+gboolean spice_decode_enabled(void) { return spice_direct_enabled(); }
+
+void spice_decode_layout(SpiceDisplay *display)
+{
+    auto *d = display->priv;
+    if (!d->display || d->dx_failed) return;
+    GtkWidget *area = gtk_stack_get_child_by_name(d->stack, "draw-area");
+    GdkWindow *window = gtk_widget_get_window(area);
+    if (!window) return;
+    auto *p = d->decode_presenter;
+    if (!p) {
+        p = new SpiceDecodePresenter;
+        d->decode_presenter = p;
+        WNDCLASSW wc = {};
+        wc.lpfnWndProc = decode_window_proc;
+        wc.hInstance = GetModuleHandleW(nullptr);
+        wc.lpszClassName = L"SpiceDecodeOutput";
+        wc.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
+        RegisterClassW(&wc);
+        HWND parent = (HWND)GDK_WINDOW_HWND(window);
+        p->window = CreateWindowExW(WS_EX_TRANSPARENT | WS_EX_NOACTIVATE,
+            wc.lpszClassName, L"", WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS,
+            0, 0, 1, 1, parent, nullptr, wc.hInstance, nullptr);
+        if (!p->window) {
+            d->dx_failed = TRUE;
+            gtk_label_set_text(GTK_LABEL(d->label), "Cannot create GPU output window");
+            gtk_stack_set_visible_child_name(d->stack, "label");
+            return;
+        }
+        SetWindowLongPtrW(parent, GWL_STYLE, GetWindowLongPtrW(parent, GWL_STYLE) | WS_CLIPCHILDREN);
+        p->channel = (SpiceDisplayChannel *)g_object_ref(d->display);
+        p->binding = g_new0(SpiceDirectBinding, 1);
+        p->binding->refs = 1;
+        g_mutex_init(&p->binding->mutex);
+        p->binding->owner = p;
+        p->binding->present = present_sample;
+        p->hub = (SpiceDirectHub *)g_object_dup_data(G_OBJECT(p->channel), "dx-direct-hub",
+                                                     spice_direct_hub_ref, nullptr);
+        if (!p->hub) {
+            p->hub = g_new0(SpiceDirectHub, 1);
+            p->hub->refs = 1;
+            g_mutex_init(&p->hub->mutex);
+            p->hub->bindings = g_ptr_array_new_with_free_func(spice_direct_unref);
+            g_object_set_data_full(G_OBJECT(p->channel), "dx-direct-hub",
+                                  spice_direct_hub_ref(p->hub, nullptr), spice_direct_hub_unref);
+        }
+        g_mutex_lock(&p->hub->mutex);
+        g_ptr_array_add(p->hub->bindings, spice_direct_ref(p->binding, nullptr));
+        g_mutex_unlock(&p->hub->mutex);
+        g_message("DX-DIRECT: native window attached to display channel");
+    }
+    /* Resize HWND on its owner thread, without waiting on DXGI/device locks. */
+    double scale;
+    int x, y, width, height;
+    spice_display_get_scaling(display, &scale, &x, &y, &width, &height);
+    g_atomic_int_set(&p->width, MAX(width, 1)); g_atomic_int_set(&p->height, MAX(height, 1));
+    g_mutex_lock(&p->binding->mutex);
+    p->crop_x = d->remote_monitor_set ? d->remote_monitor_x : 0;
+    p->crop_y = d->remote_monitor_set ? d->remote_monitor_y : 0;
+    p->crop_w = d->remote_monitor_set ? d->remote_monitor_w : 0;
+    p->crop_h = d->remote_monitor_set ? d->remote_monitor_h : 0;
+    g_mutex_unlock(&p->binding->mutex);
+    SetWindowPos(p->window, nullptr, x, y, MAX(width, 1), MAX(height, 1), SWP_NOACTIVATE | SWP_NOZORDER);
+    if (g_object_get_data(G_OBJECT(p->channel), "dx-video-error")) {
+        const char *failure = (const char *)g_object_get_data(G_OBJECT(p->channel), "dx-video-status");
+        gtk_label_set_text(GTK_LABEL(d->label), failure ? failure : "GPU presentation failed");
+        gtk_stack_set_visible_child_name(d->stack, "label");
+    } else gtk_stack_set_visible_child_name(d->stack, "draw-area");
+    GtkWidget *top = gtk_widget_get_toplevel(GTK_WIDGET(display));
+    if (GTK_IS_WINDOW(top) && !p->base_title) {
+        p->base_title = g_strdup(gtk_window_get_title(GTK_WINDOW(top)));
+        gchar *title = g_strdup_printf("%s [DX | GPU Direct]", p->base_title);
+        gtk_window_set_title(GTK_WINDOW(top), title);
+        g_free(title);
+    }
+}
+
+void spice_decode_destroy(SpiceDisplay *display)
+{
+    auto *p = display->priv->decode_presenter;
+    if (!p) return;
+    display->priv->decode_presenter = nullptr;
+    auto *binding = p->binding;
+    if (binding) {
+        g_mutex_lock(&binding->mutex);
+        binding->owner = nullptr;
+        g_mutex_unlock(&binding->mutex);
+        g_mutex_lock(&p->hub->mutex);
+        g_ptr_array_remove(p->hub->bindings, binding);
+        g_mutex_unlock(&p->hub->mutex);
+        spice_direct_hub_unref(p->hub);
+    }
+    HWND window = p->window;
+    delete p;
+    if (window) DestroyWindow(window);
+    spice_direct_unref(binding);
+}
+
+GdkPixbuf *spice_decode_snapshot(SpiceDisplay *display)
+{
+    auto *p = display->priv->decode_presenter;
+    if (!p || !p->binding) return nullptr;
+    GstSample *sample = nullptr;
+    gint cx, cy, cw, ch;
+    g_mutex_lock(&p->binding->mutex);
+    if (p->latest) sample = gst_sample_ref(p->latest);
+    cx = p->crop_x; cy = p->crop_y; cw = p->crop_w; ch = p->crop_h;
+    g_mutex_unlock(&p->binding->mutex);
+    if (!sample) return nullptr;
+    /* History requests a readback every 30 seconds, never per video frame. */
+    GstVideoInfo info;
+    GstVideoFrame frame = {};
+    GdkPixbuf *result = nullptr;
+    if (gst_video_info_from_caps(&info, gst_sample_get_caps(sample)) &&
+        gst_video_frame_map(&frame, &info, gst_sample_get_buffer(sample), GST_MAP_READ)) {
+        if (!cw) cw = info.width;
+        if (!ch) ch = info.height;
+        if (cx + cw > info.width || cy + ch > info.height) {
+            gst_video_frame_unmap(&frame);
+            gst_sample_unref(sample);
+            return nullptr;
+        }
+        result = gdk_pixbuf_new(GDK_COLORSPACE_RGB, FALSE, 8, cw, ch);
+        auto *pixels = gdk_pixbuf_get_pixels(result);
+        int stride = gdk_pixbuf_get_rowstride(result);
+        const auto *Y = (const guint8 *)GST_VIDEO_FRAME_PLANE_DATA(&frame, 0);
+        const auto *UV = (const guint8 *)GST_VIDEO_FRAME_PLANE_DATA(&frame, 1);
+        bool limited = info.colorimetry.range != GST_VIDEO_COLOR_RANGE_0_255;
+        bool bt709 = info.colorimetry.matrix == GST_VIDEO_COLOR_MATRIX_BT709;
+        for (int y = 0; y < ch; y++) for (int x = 0; x < cw; x++) {
+            float l = Y[(y + cy) * GST_VIDEO_FRAME_PLANE_STRIDE(&frame, 0) + x + cx];
+            int ci = ((y + cy) / 2) * GST_VIDEO_FRAME_PLANE_STRIDE(&frame, 1) + ((x + cx) & ~1);
+            float u = UV[ci] - 128.f, v = UV[ci + 1] - 128.f;
+            if (limited) { l = (l - 16.f) * (255.f / 219.f); u *= 255.f / 224.f; v *= 255.f / 224.f; }
+            auto *out = pixels + y * stride + x * 3;
+            out[0] = (guint8)CLAMP(l + (bt709 ? 1.5748f : 1.402f) * v, 0, 255);
+            out[1] = (guint8)CLAMP(l - (bt709 ? .1873f : .3441f) * u - (bt709 ? .4681f : .7141f) * v, 0, 255);
+            out[2] = (guint8)CLAMP(l + (bt709 ? 1.8556f : 1.772f) * u, 0, 255);
+        }
+        gst_video_frame_unmap(&frame);
+    }
+    gst_sample_unref(sample);
+    return result;
+}
