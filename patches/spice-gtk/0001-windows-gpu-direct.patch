+    ID3D11DeviceContext_ClearRenderTargetView(dx->context, dx->target, black);
+    ID3D11DeviceContext_IASetPrimitiveTopology(dx->context, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext_VSSetShader(dx->context, dx->vs, NULL, 0);
+    ID3D11DeviceContext_PSSetShader(dx->context, dx->ps, NULL, 0);
+    ID3D11DeviceContext_PSSetSamplers(dx->context, 0, 1, &dx->sampler);
+    ID3D11DeviceContext_OMSetBlendState(dx->context, NULL, NULL, 0xffffffff);
+    spice_display_get_scaling(display, &scale, &x, &y, &image_width, &image_height);
+    draw_texture(dx, dx->desktop_view, x, y, image_width, image_height);
+    if (d->mouse_mode == SPICE_MOUSE_MODE_SERVER && d->mouse_guest_x != -1 &&
+        d->mouse_guest_y != -1 && !d->show_cursor && d->mouse_pixbuf &&
+        spice_gtk_session_get_pointer_grabbed(d->gtk_session)) {
+        gint cw = gdk_pixbuf_get_width(d->mouse_pixbuf), ch = gdk_pixbuf_get_height(d->mouse_pixbuf);
+        if (dx->cursor_width != cw || dx->cursor_height != ch) {
+            if (!texture(dx, cw, ch, DXGI_FORMAT_R8G8B8A8_UNORM, &dx->cursor, &dx->cursor_view, error))
+                return FALSE;
+            dx->cursor_width = cw; dx->cursor_height = ch;
+        }
+        ID3D11DeviceContext_UpdateSubresource(dx->context, (ID3D11Resource *)dx->cursor, 0,
+                                             NULL, gdk_pixbuf_get_pixels(d->mouse_pixbuf),
+                                             gdk_pixbuf_get_rowstride(d->mouse_pixbuf), 0);
+        ID3D11DeviceContext_OMSetBlendState(dx->context, dx->blend, NULL, 0xffffffff);
+        draw_texture(dx, dx->cursor_view,
+                     x + (d->mouse_guest_x - d->mouse_hotspot.x - d->area.x) * scale,
+                     y + (d->mouse_guest_y - d->mouse_hotspot.y - d->area.y) * scale,
+                     cw * scale, ch * scale);
+    }
+    /* Keep tearing disabled. Waitable scheduling limits outstanding presents. */
+    DX_TRY(IDXGISwapChain1_Present(dx->swap, 1, 0));
+    if (++dx->frames == 1)
+        g_message("DX-H264: first desktop frame presented via DXGI; CPU canvas upload, not zero-copy");
+    SpiceDxLatencyFrame *trace = d->display ? g_object_get_data(G_OBJECT(d->display), "dx-latency-frame") : NULL;
+    if (trace && trace->received_us != dx->last_traced_frame) {
+        gint64 now = g_get_monotonic_time();
+        dx->last_traced_frame = trace->received_us;
+        g_message("DX-LATENCY marker=%d wall_us=%" G_GINT64_FORMAT
+                  " decode_us=%" G_GINT64_FORMAT " hold_us=%" G_GINT64_FORMAT
+                  " draw_us=%" G_GINT64_FORMAT " client_us=%" G_GINT64_FORMAT
+                  " parse_us=%" G_GINT64_FORMAT " hardware_us=%" G_GINT64_FORMAT " download_us=%" G_GINT64_FORMAT,
+                  trace->marker_valid ? (gint)trace->marker : -1, g_get_real_time(),
+                  trace->decoded_us - trace->received_us,
+                  trace->composed_us - trace->decoded_us, now - trace->composed_us,
+                  now - trace->received_us, trace->parsed_us - trace->received_us,
+                  trace->hardware_us - trace->parsed_us, trace->decoded_us - trace->hardware_us);
+    }
+    return TRUE;
+fail:
+    RELEASE(backbuffer);
+    return FALSE;
+}
+
+static gboolean redraw(gpointer data)
+{
+    SpiceDisplay *display = SPICE_DISPLAY(data);
+    SpiceDisplayPrivate *d = display->priv;
+    GError *error = NULL;
+    d->dx->scheduled = 0;
+    if (!render(display, &error)) {
+        gchar *text = g_strdup_printf("DX / H.264 failed: %s\nNo alternate backend was selected.",
+                                      error ? error->message : "unknown error");
+        g_warning("%s", text);
+        spice_d3d11_destroy(display);
+        d->dx_failed = TRUE;
+        gtk_label_set_text(GTK_LABEL(d->label), text);
+        gtk_stack_set_visible_child_name(d->stack, "label");
+        g_free(text);
+        g_clear_error(&error);
+    } else if (d->dx->retry &&
+               gtk_widget_get_mapped(GTK_WIDGET(display))) {
+        d->dx->scheduled = g_timeout_add_full(G_PRIORITY_DEFAULT, 4, redraw,
+                                              g_object_ref(display), g_object_unref);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+void spice_d3d11_queue(SpiceDisplay *display)
+{
+    SpiceDisplayPrivate *d = display->priv;
+    if (spice_decode_enabled()) {
+        spice_decode_layout(display);
+        return;
+    }
+    if (!spice_d3d11_enabled() || d->dx_failed)
+        return;
+    if (!d->dx)
+        d->dx = g_new0(SpiceD3D11, 1);
+    if (!d->dx->scheduled)
+        d->dx->scheduled = g_idle_add_full(G_PRIORITY_DEFAULT_IDLE, redraw,
+                                          g_object_ref(display), g_object_unref);
+}
