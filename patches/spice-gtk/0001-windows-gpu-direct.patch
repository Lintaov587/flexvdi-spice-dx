+    SpiceDirectHub *hub = nullptr;
+    SpiceDisplayChannel *channel = nullptr;
+    GstD3D11Device *device = nullptr;
+    IDXGISwapChain1 *swap = nullptr;
+    ID3D11VideoDevice *video_device = nullptr;
+    ID3D11VideoContext *video_context = nullptr;
+    ID3D11VideoProcessorEnumerator *enumerator = nullptr;
+    ID3D11VideoProcessor *processor = nullptr;
+    GstSample *latest = nullptr;
+    gint width = 1, height = 1;
+    gint crop_x = 0, crop_y = 0, crop_w = 0, crop_h = 0;
+    gint buffer_width = 0, buffer_height = 0, source_width = 0, source_height = 0;
+    guint64 presented = 0, busy = 0;
+    guint64 attempts = 0;
